---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import TestCard from '../../../components/TestCard.astro';
import EvidenceBadge from '../../../components/EvidenceBadge.astro';
import { liveLocales } from '../../../i18n/config';
import { categories } from '../../../lib/categories';
import { testDefinitions } from '../../../data/tests/index';
import { getRegistryByCategory } from '../../../data/registry';
import { breadcrumbList, collectionPage } from '../../../lib/structured-data';

export function getStaticPaths() {
  return liveLocales.flatMap((l) => categories.map((c) => ({ params: { lang: l.code, category: c.slug } })));
}

const { lang, category: categorySlug } = Astro.params;
const category = categories.find((c) => c.slug === categorySlug)!;
const site = Astro.site?.toString().replace(/\/$/, '') ?? '';

const publishedTests = testDefinitions.filter((t) => t.category === category.id);
const registryEntries = getRegistryByCategory(category.id);
const upcoming = registryEntries.filter((r) => r.status !== 'published');

const path = `${category.slug}/`;
const jsonLd = [
  breadcrumbList(site, [
    { name: 'Home', path: `/${lang}/` },
    { name: category.name, path: `/${lang}/${path}` },
  ]),
  collectionPage(
    site, `/${lang}/${path}`, `${category.name} Assessments`, category.shortDescription,
    publishedTests.map((t) => `/${lang}/tests/${t.slug}/`)
  ),
];
---
<BaseLayout
  lang={lang!}
  title={`${category.name} Assessments`}
  description={category.shortDescription}
  path={path}
  jsonLd={jsonLd}
>
  <div class="shell section-tight">
    <Breadcrumbs items={[{ name: 'Home', href: `/${lang}/` }, { name: category.name, href: `/${lang}/${path}` }]} />
  </div>

  <section class="section-tight">
    <div class="shell prose">
      <h1>{category.name}</h1>
      <p style="font-size:var(--text-lg); color:var(--color-text-secondary);">{category.intro}</p>

      <h2>What you can learn here</h2>
      <ul>
        {category.whatYouCanLearn.map((item) => <li>{item}</li>)}
      </ul>

      <h2>Limitations of this category</h2>
      <p>{category.limitations}</p>
    </div>
  </section>

  <section class="section-tight">
    <div class="shell">
      <h2 class="eyebrow" style="margin-top:0;">Available now</h2>
      {publishedTests.length > 0 ? (
        <div class="card-grid">
          {publishedTests.map((t) => <TestCard test={t} lang={lang!} />)}
        </div>
      ) : (
        <p style="color:var(--color-text-secondary);">No assessments in this category have cleared evidence and licensing review yet. See what's on the roadmap below.</p>
      )}
    </div>
  </section>

  {upcoming.length > 0 && (
    <section class="section-tight">
      <div class="shell">
        <h2 class="eyebrow" style="margin-top:0;">On the roadmap</h2>
        <p style="color:var(--color-text-secondary); max-width:640px;">
          These assessments are planned for this category but are not yet published — either because the interactive
          test hasn't been built yet, or because we could not yet verify licensing, translation, or scoring rights
          for the underlying instrument. See our <a href={`/${lang}/evidence-policy/`}>evidence policy</a>.
        </p>
        <table>
          <thead><tr><th>Assessment</th><th>Evidence level</th><th>Status</th></tr></thead>
          <tbody>
            {upcoming.map((r) => (
              <tr>
                <td>{r.name}</td>
                <td><EvidenceBadge level={r.evidenceLevel} /></td>
                <td style="text-transform:capitalize;">{r.status.replace('-', ' ')}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}
</BaseLayout>
