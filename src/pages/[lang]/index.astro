---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TestCard from '../../components/TestCard.astro';
import { liveLocales, siteName, siteTagline } from '../../i18n/config';
import { categories } from '../../lib/categories';
import { testDefinitions } from '../../data/tests/index';
import { websiteAndOrg } from '../../lib/structured-data';

export function getStaticPaths() {
  return liveLocales.map((l) => ({ params: { lang: l.code } }));
}

const { lang } = Astro.params;
const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const jsonLd = websiteAndOrg(site, siteName);
---
<BaseLayout
  lang={lang!}
  title={`${siteName} — ${siteTagline}`}
  description="Evidence-informed self-assessments for personality, mental wellbeing, work, relationships, and everyday life. No accounts, no ads for your answers — scoring happens in your browser."
  path=""
  jsonLd={jsonLd}
>
  <section class="section" style="padding-top:var(--space-9);">
    <div class="shell prose" style="text-align:center; max-width:680px;">
      <h1 style="font-size:var(--text-3xl);">Understand yourself better.</h1>
      <p style="font-size:var(--text-lg); color:var(--color-text-secondary);">
        Evidence-informed self-assessments for personality, wellbeing, work, relationships, and everyday life.
      </p>
      <form action={`/${lang}/search/`} method="get" role="search" class="search-box" style="margin: var(--space-6) auto 0;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"/><path d="M21 21L16.65 16.65" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        <label class="sr-only" for="home-search">Search tests</label>
        <input id="home-search" type="search" name="q" placeholder="Search tests — try “focus” or “anxiety”" />
      </form>
    </div>
  </section>

  <section class="section-tight">
    <div class="shell">
      <h2 class="eyebrow" style="margin-top:0;">Popular assessments</h2>
      <div class="card-grid">
        {testDefinitions.map((t) => <TestCard test={t} lang={lang!} />)}
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="shell">
      <h2 class="eyebrow" style="margin-top:0;">Browse by category</h2>
      <div class="card-grid">
        {categories.map((c) => (
          <a class="card" href={`/${lang}/${c.slug}/`}>
            <h3>{c.name}</h3>
            <p style="color:var(--color-text-secondary); margin-bottom:0;">{c.shortDescription}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="shell prose">
      <div class="callout">
        <h4>How we classify evidence</h4>
        <p style="margin-bottom:0;">
          Every test on {siteName} is labeled with an evidence level: <strong>validated screening tool</strong>,
          <strong>public-domain psychological scale</strong>, <strong>evidence-informed self-assessment</strong>, or
          <strong>entertainment quiz</strong>. We never present an evidence-informed or entertainment quiz as clinically
          validated. Read our <a href={`/${lang}/evidence-policy/`}>evidence policy</a> and <a href={`/${lang}/methodology/`}>methodology</a>.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
